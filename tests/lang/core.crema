# Core semantics: stack, arithmetic, comparison, variables.

# stack words
1 2 swap 1 assert-eq 2 assert-eq
1 2 3 2 pick 1 assert-eq clear
1 2 3 rot 1 assert-eq 3 assert-eq 2 assert-eq
1 2 3 -rot 2 assert-eq 1 assert-eq 3 assert-eq
1 2 over 1 assert-eq 2 assert-eq 1 assert-eq
1 2 nip 2 assert-eq depth 0 assert-eq
1 2 tuck 2 assert-eq 1 assert-eq 2 assert-eq
1 2 2dup + 3 assert-eq 2 assert-eq 1 assert-eq
4 5 2drop depth 0 assert-eq

# arithmetic
2 3 + 5 assert-eq
2 3 - -1 assert-eq
6 7 * 42 assert-eq
6 3 / 2 assert-eq
7 2 / 3.5 assert-eq
7 2 div 3 assert-eq
-7 2 mod 1 assert-eq
2 100 ** 1267650600228229401496703205376 assert-eq
0x1F 31 assert-eq
2.5 floor 2 assert-eq
2.5 round 3 assert-eq
16 sqrt 4.0 assert-eq
3 neg abs 3 assert-eq
3 9 min 3 assert-eq
3 9 max 9 assert-eq
[ 1 0 / ] assert-error

# comparison & logic
1 1.0 = true assert-eq
1 true = false assert-eq
"a" "b" < true assert-eq
{1 2} {1 3} < true assert-eq
3 2 >= true assert-eq
true false and false assert-eq
nil 0 or true assert-eq    # only false and nil are falsy
0 not false assert-eq
true "yes" "no" ? "yes" assert-eq

# variables are local to each function call
10 -> x
: shadow ( -- n ) 99 -> x x ;
shadow 99 assert-eq
x 10 assert-eq
: read-global ( -- n ) x ;
read-global 10 assert-eq

# closures capture the scope they were created in
: adder ( n -- [q] ) -> n [ n + ] ;
5 adder -> add5
10 add5 call 15 assert-eq

# runtime definitions
"triple" [ 3 * ] def
4 triple 12 assert-eq
"1 2 +" eval 3 assert-eq

# conversions
"42" int 42 assert-eq
"3.5" num 3.5 assert-eq
"abc" num nil assert-eq
3.9 int 3 assert-eq
42 str "42" assert-eq
"hi" repr "\"hi\"" assert-eq
{1 "a" nil} type "list" assert-eq
[ 1 ] type "quote" assert-eq

depth 0 assert-eq
"core ok" println
